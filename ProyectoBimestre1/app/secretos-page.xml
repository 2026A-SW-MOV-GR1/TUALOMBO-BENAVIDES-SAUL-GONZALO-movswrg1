<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
    <StackLayout padding="20">
        <Label text="Gestión de Secretos" class="h1" />

        <TextField id="keyInput" hint="Llave" />
        <TextField id="valueInput" hint="Valor" />

        <ListPicker id="storageSelector" />

        <Button text="Guardar Acción" tap="onSaveTap" />
        <Button text="Recuperar Acción" tap="onRecoverTap" />
    </StackLayout>
</Page>
