<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
    <StackLayout padding="20">
        <Label text="Módulo 1: REST API" class="h1" />

        <TextField id="idInput" hint="Ingrese ID del Post" keyboardType="number" />

        <Button id="btnGet" text="Consultar (GET)" tap="onGetTap" />

        <TextView id="jsonOutput" hint="Contenido del Post..." editable="true" />

        <Button id="btnPut" text="Actualizar (PUT)" tap="onPutTap" />

        <ActivityIndicator id="loader" busy="false" visibility="collapse" />
    </StackLayout>
</Page>
